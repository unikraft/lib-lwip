-#define netconn_set_flags(conn, set_flags)     do { (conn)->flags = (u8_t)((conn)->flags |  (set_flags)); } while(0)
-#define netconn_clear_flags(conn, clr_flags)   do { (conn)->flags = (u8_t)((conn)->flags & (u8_t)(~(clr_flags) & 0xff)); } while(0)
-#define netconn_is_flag_set(conn, flag)        (((conn)->flags & (flag)) != 0)
+/* Socket I/O and the TCP/IP thread update independent bits in the same
+ * byte. All accesses to a published netconn must preserve those updates.
+ */
+static inline u8_t
+netconn_get_flags(const struct netconn *conn)
+{
+  u8_t flags;
+
+  SYS_ARCH_GET(conn->flags, flags);
+  return flags;
+}
+
+static inline void
+netconn_set_flags(struct netconn *conn, u8_t flags)
+{
+  SYS_ARCH_LOCKED(conn->flags |= flags);
+}
+
+static inline u8_t
+netconn_take_flags(struct netconn *conn, u8_t mask)
+{
+  u8_t flags;
+
+  SYS_ARCH_LOCKED(
+    flags = conn->flags & mask;
+    if (flags) {
+      conn->flags &= (u8_t)~mask;
+    }
+  );
+  return flags;
+}
+
+#define netconn_clear_flags(conn, mask)      ((void)netconn_take_flags((conn), (mask)))
+#define netconn_is_flag_set(conn, flag)      ((netconn_get_flags(conn) & (flag)) != 0)
 
