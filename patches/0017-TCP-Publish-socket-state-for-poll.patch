diff --git a/src/api/api_msg.c b/src/api/api_msg.c
index b79a574..37390bc 100644
--- a/src/api/api_msg.c
+++ b/src/api/api_msg.c
@@ -335,6 +335,9 @@ recv_tcp(void *arg, struct tcp_pcb *pcb, struct pbuf *p, err_t err)
 #if LWIP_SO_RCVBUF
     SYS_ARCH_INC(conn->recv_avail, len);
 #endif /* LWIP_SO_RCVBUF */
+    if (p == NULL) {
+      SYS_ARCH_LOCKED(conn->tcp_poll_state |= NETCONN_TCP_POLL_READ_CLOSED);
+    }
     /* Register event with callback */
     API_EVENT(conn, NETCONN_EVT_RCVPLUS, len);
   }
@@ -443,6 +446,7 @@ err_tcp(void *arg, err_t err)

   /* when err is called, the pcb is deallocated, so delete the reference */
   conn->pcb.tcp = NULL;
+  conn->tcp_poll_state = NETCONN_TCP_POLL_READ_CLOSED;
   /* store pending error */
   conn->pending_err = err;
   /* prevent application threads from blocking on 'recvmbox'/'acceptmbox' */
@@ -568,6 +572,7 @@ accept_function(void *arg, struct tcp_pcb *newpcb, err_t err)
     return ERR_MEM;
   }
   newconn->pcb.tcp = newpcb;
+  SYS_ARCH_LOCKED(newconn->tcp_poll_state = NETCONN_TCP_POLL_WRITE_OPEN);
   setup_tcp(newconn);

   /* handle backlog counter */
@@ -754,6 +759,7 @@ netconn_alloc(enum netconn_type t, netconn_callback callback)

 #if LWIP_TCP
   sys_mbox_set_invalid(&conn->acceptmbox);
+  conn->tcp_poll_state = 0;
 #endif
   conn->state        = NETCONN_NONE;
 #if LWIP_SOCKET
@@ -1060,6 +1066,18 @@ lwip_netconn_do_close_internal(struct netconn *conn  WRITE_DELAYED_PARAM)
     conn->current_msg = NULL;
     conn->state = NETCONN_NONE;
     if (err == ERR_OK) {
+      SYS_ARCH_DECL_PROTECT(poll_state);
+      SYS_ARCH_PROTECT(poll_state);
+      if (shut_rx) {
+        conn->tcp_poll_state |= NETCONN_TCP_POLL_READ_CLOSED;
+      }
+      if (shut_tx) {
+        conn->tcp_poll_state &= (u8_t)~NETCONN_TCP_POLL_WRITE_OPEN;
+      }
+      if (shut_close) {
+        conn->tcp_poll_state &= (u8_t)~NETCONN_TCP_POLL_LISTEN;
+      }
+      SYS_ARCH_UNPROTECT(poll_state);
       if (shut_close) {
         /* Set back some callback pointers as conn is going away */
         conn->pcb.tcp = NULL;
@@ -1330,6 +1348,11 @@ lwip_netconn_do_connected(void *arg, struct tcp_pcb *pcb, err_t err)
               (!was_blocking && op_completed_sem == NULL));
   conn->current_msg = NULL;
   conn->state = NETCONN_NONE;
+  SYS_ARCH_LOCKED(conn->tcp_poll_state = err == ERR_OK ?
+                  NETCONN_TCP_POLL_WRITE_OPEN : NETCONN_TCP_POLL_READ_CLOSED);
+  if (err != ERR_OK) {
+    API_EVENT(conn, NETCONN_EVT_ERROR, 0);
+  }
   API_EVENT(conn, NETCONN_EVT_SENDPLUS, 0);

   if (was_blocking) {
@@ -1494,6 +1517,7 @@ lwip_netconn_do_listen(void *m)
             }
             if (err == ERR_OK) {
               msg->conn->state = NETCONN_LISTEN;
+              SYS_ARCH_LOCKED(msg->conn->tcp_poll_state = NETCONN_TCP_POLL_LISTEN);
               msg->conn->pcb.tcp = lpcb;
               tcp_arg(msg->conn->pcb.tcp, msg->conn);
               tcp_accept(msg->conn->pcb.tcp, accept_function);
