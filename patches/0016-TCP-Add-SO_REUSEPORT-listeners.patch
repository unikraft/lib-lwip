+static u32_t
+tcp_reuseport_flow_hash(void)
+{
+  const ip_addr_t *src = ip_current_src_addr();
+  const ip_addr_t *dst = ip_current_dest_addr();
+  u32_t hash = ((u32_t)tcphdr->src << 16) | tcphdr->dest;
+
+#if LWIP_IPV6
+  if (IP_IS_V6(src)) {
+    int i;
+    for (i = 0; i < 4; i++) {
+      hash = (hash ^ ip_2_ip6(src)->addr[i]) * 16777619U;
+      hash = (hash ^ ip_2_ip6(dst)->addr[i]) * 16777619U;
+    }
+  }
+#endif /* LWIP_IPV6 */
+#if LWIP_IPV4
+  if (IP_IS_V4(src)) {
+    hash = (hash ^ ip4_addr_get_u32(ip_2_ip4(src))) * 16777619U;
+    hash = (hash ^ ip4_addr_get_u32(ip_2_ip4(dst))) * 16777619U;
+  }
+#endif /* LWIP_IPV4 */
+
+  hash = (hash ^ (hash >> 16)) * 0x85ebca6bU;
+  hash = (hash ^ (hash >> 13)) * 0xc2b2ae35U;
+  return hash ^ (hash >> 16);
+}
+
+static int
+tcp_reuseport_member(const struct tcp_pcb_listen *pcb,
+                     const struct tcp_pcb_listen *first)
+{
+  return ip_get_option(pcb, SOF_REUSEPORT) &&
+         (pcb->local_port == first->local_port) &&
+         (pcb->netif_idx == first->netif_idx) &&
+         ip_addr_cmp(&pcb->local_ip, &first->local_ip);
+}
+
+static struct tcp_pcb_listen *
+tcp_reuseport_select(struct tcp_pcb_listen *first)
+{
+  struct tcp_pcb_listen *pcb;
+  u32_t count = 0;
+  u32_t index;
+
+  for (pcb = tcp_listen_pcbs.listen_pcbs; pcb != NULL; pcb = pcb->next) {
+    if (tcp_reuseport_member(pcb, first)) {
+      count++;
+    }
+  }
+  if (count < 2) {
+    return first;
+  }
+
+  /* The core lock keeps membership and order stable across both scans. */
+  index = tcp_reuseport_flow_hash() % count;
+  for (pcb = tcp_listen_pcbs.listen_pcbs; pcb != NULL; pcb = pcb->next) {
+    if (!tcp_reuseport_member(pcb, first)) {
+      continue;
+    }
+    if (index == 0) {
+      return pcb;
+    }
+    index--;
+  }
+  return first;
+}
