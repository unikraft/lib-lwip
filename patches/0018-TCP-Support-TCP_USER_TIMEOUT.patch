+/* The oldest transmitted segment may be back in unsent for retransmission. */
+static int
+tcp_user_timeout_expired(const struct tcp_pcb *pcb, u32_t timeout)
+{
+  const struct tcp_seg *first = pcb->unacked;
+  const struct tcp_seg *unsent = pcb->unsent;
+
+  if (unsent != NULL && (unsent->flags & TF_SEG_SENT) &&
+      (first == NULL || TCP_SEQ_LT(lwip_ntohl(unsent->tcphdr->seqno),
+                                  lwip_ntohl(first->tcphdr->seqno)))) {
+    first = unsent;
+  }
+  if (first != NULL) {
+    return (u32_t)(sys_now() - first->first_sent) >= timeout;
+  }
+  return pcb->persist_backoff && (u32_t)(sys_now() - pcb->persist_started) >= timeout;
